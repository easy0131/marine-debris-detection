# ===========================================================================

REFERENCE_TARGET_CLASSES = {
    "해안쓰레기_스티로폼": (255, 0, 0),    # red
    "해안쓰레기_플라스틱": (0, 255, 0),    # green
    "해안쓰레기_기타": (0, 128, 255),      # orange-blue
}


def reference_world_to_pixel(x, y, top_left_x, top_left_y, resolution):
    """
    폴리곤 좌표(실세계 EPSG:32652 미터 단위)를 이미지 픽셀 좌표로 변환.
    북쪽이 위(North-up)라고 가정: 이미지 y는 아래로 갈수록 증가,
    실세계 y(북쪽)는 위로 갈수록 증가하므로 부호가 반대입니다.
    """
    px = (x - top_left_x) / resolution
    py = (top_left_y - y) / resolution
    return px, py


def reference_load_metadata(meta_json_path):
    with open(meta_json_path, "r", encoding="utf-8") as f:
        meta = json.load(f)
    entry = meta[0] if isinstance(meta, list) else meta
    top_left_x, top_left_y = [float(v) for v in entry["coordinates"].split(",")]
    resolution = float(entry["img_resolution"])
    return {
        "img_id": entry["img_id"],
        "top_left_x": top_left_x,
        "top_left_y": top_left_y,
        "resolution": resolution,
    }


def reference_rasterize_annotations(geojson_path, meta, img_width, img_height):
    """폴리곤 어노테이션을 픽셀 마스크(클래스별 컬러 오버레이, RGB)로 변환."""
    with open(geojson_path, "r", encoding="utf-8") as f:
        gj = json.load(f)

    overlay = np.zeros((img_height, img_width, 3), dtype=np.uint8)
    found_any = False

    for feature in gj.get("features", []):
        class_name = feature["properties"].get("ANN_NM")
        if class_name not in REFERENCE_TARGET_CLASSES:
            continue  # 해안쓰레기 클래스가 아니면 건너뜀

        found_any = True
        color = REFERENCE_TARGET_CLASSES[class_name]
        geom = feature["geometry"]
        coords_list = (
            geom["coordinates"] if geom["type"] == "MultiPolygon" else [geom["coordinates"]]
        )

        for polygon in coords_list:
            ring = polygon[0]  # 외곽선만 사용 (구멍은 무시)
            pixel_ring = np.array([
                reference_world_to_pixel(
                    x, y, meta["top_left_x"], meta["top_left_y"], meta["resolution"]
                )
                for x, y in ring
            ], dtype=np.int32)
            cv2.fillPoly(overlay, [pixel_ring], color)

    return overlay, found_any


def view_reference_sample(tif_path, geojson_path, meta_json_path, save_path=None):
    """
    드론 원본 tif + 해안쓰레기 폴리곤 라벨을 겹쳐서 보여줍니다.
    참고/학습 자료 이해용이며, 이 함수의 출력은 실제 모델 학습/추론에 사용하지 않습니다.
    """
    image = np.array(Image.open(tif_path).convert("RGB"))
    meta = reference_load_metadata(meta_json_path)
    overlay, found_any = reference_rasterize_annotations(
        geojson_path, meta, image.shape[1], image.shape[0]
    )

    if not found_any:
        print(f"[info] {meta['img_id']}: 이 이미지에는 해안쓰레기 라벨이 없습니다.")

    blended = cv2.addWeighted(image, 0.7, overlay, 0.5, 0)

    fig, axes = plt.subplots(1, 2, figsize=(12, 6))
    axes[0].imshow(image)
    axes[0].set_title(f"원본 (0.1m 드론) - {meta['img_id']}")
    axes[0].axis("off")

    axes[1].imshow(blended)
    axes[1].set_title("해안쓰레기 라벨 오버레이 (참고용)")
    axes[1].axis("off")

    plt.tight_layout()
    if save_path:
        plt.savefig(save_path, dpi=150)
        print(f"Saved to {save_path}")
    else:
        plt.show()

