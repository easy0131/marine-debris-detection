# ---------------------------------------------------------------------------
# 2단계: 모델 로딩
# ---------------------------------------------------------------------------
def load_model(checkpoint_path: str, device: str = DEVICE):
    """
    Loads the trained checkpoint. Architecture and checkpoint format below
    are CONFIRMED (not guessed) against the user's own training notes:
      - smp.Unet(encoder_name="resnet18", in_channels=3, classes=2) was the
        exact training-time architecture (encoder_weights="imagenet" was
        only used to initialize training - irrelevant here).
      - encoder_weights=None is correct at inference: the saved state_dict
        already contains the fully-trained encoder weights, which overwrite
        whatever the ImageNet init would have set.
      - checkpoint format is {"state_dict": model.state_dict()}, matching
        checkpoint["state_dict"] below.
    """
    checkpoint = torch.load(checkpoint_path, map_location=device, weights_only=False)
    state_dict = checkpoint["state_dict"]

    model = smp.Unet(
        encoder_name="resnet18",
        encoder_weights=None,   # we're loading our own trained weights, not ImageNet ones
        in_channels=3,
        classes=2,              # confirmed from segmentation_head.0.weight shape (2, 16, 3, 3)
    )
    missing, unexpected = model.load_state_dict(state_dict, strict=False)
    if missing or unexpected:
        print("[warn] missing keys:", missing)
        print("[warn] unexpected keys:", unexpected)
    model.to(device)
    model.eval()
    return model


# ---------------------------------------------------------------------------
# Preprocessing / inference
# ---------------------------------------------------------------------------
def preprocess_image(image_path: str, size: int = INPUT_SIZE):
    img = Image.open(image_path).convert("RGB")
    orig_w, orig_h = img.size
    img_resized = img.resize((size, size), Image.BILINEAR)

    arr = np.array(img_resized, dtype=np.float32) / 255.0
    arr = (arr - MEAN) / STD
    tensor = torch.from_numpy(arr).permute(2, 0, 1).unsqueeze(0).float()  # (1, 3, H, W)
    return tensor, (orig_w, orig_h)


@torch.no_grad()
def run_inference(model, tensor, device: str = DEVICE):
    tensor = tensor.to(device)
    logits = model(tensor)                       # (1, 2, H, W)
    probs = F.softmax(logits, dim=1)              # class probabilities
    waste_prob = probs[0, 1].cpu().numpy()        # channel 1 = waste, per segmentation_head shape
    pred_mask = (waste_prob > 0.5).astype(np.uint8)
    return pred_mask, waste_prob


# ---------------------------------------------------------------------------
# 3단계: 후처리 및 면적/규모 산출 (pure numpy - no opencv)
# ---------------------------------------------------------------------------
def _erode3x3(mask: np.ndarray) -> np.ndarray:
    """Binary erosion with a full 3x3 kernel. Border padded with 1 (foreground)
    so edges aren't artificially eaten away, matching cv2's default behavior."""
    padded = np.pad(mask.astype(bool), 1, mode="constant", constant_values=True)
    out = np.ones_like(mask, dtype=bool)
    h, w = mask.shape
    for dy in (-1, 0, 1):
        for dx in (-1, 0, 1):
            out &= padded[1 + dy:1 + dy + h, 1 + dx:1 + dx + w]
    return out.astype(np.uint8)


def _dilate3x3(mask: np.ndarray) -> np.ndarray:
    """Binary dilation with a full 3x3 kernel. Border padded with 0 (background)."""
    padded = np.pad(mask.astype(bool), 1, mode="constant", constant_values=False)
    out = np.zeros_like(mask, dtype=bool)
    h, w = mask.shape
    for dy in (-1, 0, 1):
        for dx in (-1, 0, 1):
            out |= padded[1 + dy:1 + dy + h, 1 + dx:1 + dx + w]
    return out.astype(np.uint8)


def clean_mask(mask: np.ndarray) -> np.ndarray:
    """Remove salt-and-pepper noise from the raw predicted mask via
    morphological open (erode->dilate) then close (dilate->erode)."""
    opened = _dilate3x3(_erode3x3(mask))
    closed = _erode3x3(_dilate3x3(opened))
    return closed


def extract_components(mask: np.ndarray, min_pixels: int = MIN_BLOB_PIXELS):
    """
    8-connectivity connected-component labeling implemented with a simple
    flood fill (pure numpy/Python, no opencv). Identifies individual trash
    clusters and filters out blobs smaller than min_pixels.
    """
    h, w = mask.shape
    visited = mask.astype(bool)
    labels = np.zeros((h, w), dtype=np.int32)
    components = []
    current_label = 0

    for i in range(h):
        for j in range(w):
            if visited[i, j] and labels[i, j] == 0:
                current_label += 1
                stack = [(i, j)]
                labels[i, j] = current_label
                ys, xs = [], []
                while stack:
                    y, x = stack.pop()
                    ys.append(y)
                    xs.append(x)
                    for dy in (-1, 0, 1):
                        for dx in (-1, 0, 1):
                            if dy == 0 and dx == 0:
                                continue
                            ny, nx = y + dy, x + dx
                            if (
                                0 <= ny < h and 0 <= nx < w
                                and visited[ny, nx] and labels[ny, nx] == 0
                            ):
                                labels[ny, nx] = current_label
                                stack.append((ny, nx))

                area_px = len(ys)
                if area_px >= min_pixels:
                    ys_arr, xs_arr = np.array(ys), np.array(xs)
                    components.append({
                        "label": current_label,
                        "area_px": area_px,
                        "centroid": (float(xs_arr.mean()), float(ys_arr.mean())),
                        "bbox": (
                            int(xs_arr.min()), int(ys_arr.min()),
                            int(xs_arr.max() - xs_arr.min() + 1),
                            int(ys_arr.max() - ys_arr.min() + 1),
                        ),
                    })
    return components, labels


def pixels_to_area_m2(pixel_count: int, gsd_x: float = GSD_X, gsd_y: float = GSD_Y) -> float:
    """Total Area (m^2) = Pixel Count x (GSD_x * GSD_y), per the PDF formula."""
    return pixel_count * gsd_x * gsd_y


# ---------------------------------------------------------------------------
# 4단계: 제출 형식 인코딩
# ---------------------------------------------------------------------------
def rle_encode(mask: np.ndarray) -> str:
    """Run-length encoding, Kaggle-style, for a binary mask."""
    pixels = mask.flatten(order="F")  # column-major, common Kaggle convention
    pixels = np.concatenate([[0], pixels, [0]])
    runs = np.where(pixels[1:] != pixels[:-1])[0] + 1
    runs[1::2] -= runs[::2]
    return " ".join(str(x) for x in runs)


def rle_decode(rle_string: str, shape: tuple) -> np.ndarray:
    """
    Inverse of rle_encode - rebuilds a binary mask from a Kaggle-style RLE
    string. Useful for sanity-checking your own output, or for decoding a
    provided ground-truth / sample-submission CSV (train_patches.csv id,rle
    format) to compare against predictions.
    """
    if not rle_string or not rle_string.strip():
        return np.zeros(shape, dtype=np.uint8)
    parts = rle_string.split()
    starts = np.array(parts[0::2], dtype=int) - 1
    lengths = np.array(parts[1::2], dtype=int)
    ends = starts + lengths
    flat = np.zeros(shape[0] * shape[1], dtype=np.uint8)
    for lo, hi in zip(starts, ends):
        flat[lo:hi] = 1
    return flat.reshape(shape, order="F")


# ---------------------------------------------------------------------------
# Full per-image pipeline
# ---------------------------------------------------------------------------
def process_image(model, image_path: str, device: str = DEVICE):
    image_id = os.path.splitext(os.path.basename(image_path))[0]

    tensor, (orig_w, orig_h) = preprocess_image(image_path)
    raw_mask, waste_prob = run_inference(model, tensor, device)

    mask = clean_mask(raw_mask)
    components, labels = extract_components(mask)

    total_pixels = sum(c["area_px"] for c in components)
    waste_area_m2 = pixels_to_area_m2(total_pixels)

    # Confidence: mean predicted probability over the pixels kept as waste
    if total_pixels > 0:
        confidence = float(waste_prob[mask.astype(bool)].mean())
    else:
        confidence = 0.0

    return {
        "Image_ID": image_id,
        "Waste_Area_m2": round(waste_area_m2, 3),
        "Confidence_Score": round(confidence, 4),
        "Num_Clusters": len(components),
        "RLE": rle_encode(mask),
    }


def run_batch(model, image_dir: str, output_csv: str, device: str = DEVICE):
    image_paths = sorted(
        glob.glob(os.path.join(image_dir, "*.png"))
        + glob.glob(os.path.join(image_dir, "*.jpg"))
        + glob.glob(os.path.join(image_dir, "*.tif"))
    )
    if not image_paths:
        print(f"[warn] no images found in {image_dir}")
        return None

    fieldnames = ["Image_ID", "Waste_Area_m2", "Confidence_Score", "Num_Clusters", "RLE"]
    rows = []
    for path in image_paths:
        row = process_image(model, path, device)
        rows.append(row)
        print(f"{row['Image_ID']}: {row['Waste_Area_m2']} m^2, "
              f"confidence={row['Confidence_Score']}, clusters={row['Num_Clusters']}")

    with open(output_csv, "w", newline="", encoding="utf-8-sig") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)

    print(f"\nSaved {len(rows)} rows to {output_csv}")
    return rows


